---
import '../styles/global.css';
import ProjectCard from '../components/ProjectCard.astro';
import SectionCard from '../components/SectionCard.astro';
import { loadPortfolio } from '../lib/github';
import { plural } from '../lib/plural';
import { about, skills, education } from '../data/profile';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const portfolio = await loadPortfolio();
const buildDate = new Date().toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const avatar = `${base}/avatar.jpg`;

// Резюме кладётся в public/resume.pdf. Пока файла нет — ссылку не
// показываем, чтобы не вести на 404.
const hasResume = existsSync(join(process.cwd(), 'public', 'resume.pdf'));
const resumeUrl = `${base}/resume.pdf`;

// Раздел без проектов показываем только если у него явно стоит
// hideWhenEmpty: false — пустая плитка «0 проектов» обычно выглядит
// как недоделка, но новое направление может быть видно сразу.
const visibleSections = portfolio.filter(
  ({ section, projects }) => projects.length > 0 || section.hideWhenEmpty === false,
);

const allProjects = portfolio.flatMap((group) => group.projects);
const recent = allProjects.slice(0, 6);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Пустовойтов Константин — портфолио</title>
    <meta
      name="description"
      content="Портфолио Константина Пустовойтова: CAD и инженерия, локальные LLM и автоматизация, игры и геймдизайн. 4 курс Московского политеха."
    />
  </head>
  <body>
    <main class="container">
      <header class="hero">
        <img class="avatar" src={avatar} alt="Пустовойтов Константин" />
        <div class="hero-text">
          <h1>Пустовойтов Константин</h1>
          <ul class="facts">
            <li>21 год</li>
            <li>Москва</li>
            <li>Московский политех</li>
            <li>4 курс</li>
          </ul>
          <ul class="contacts">
            <li>
              <a href="https://github.com/mbyourk1337" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
                GitHub
              </a>
            </li>
            <li>
              <a href="https://t.me/Mbyourd" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m22 2-7 20-4-9-9-4Z" />
                  <path d="M22 2 11 13" />
                </svg>
                @Mbyourd
              </a>
            </li>
            <li>
              <a href="mailto:mbyourk@gmail.com">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m2 6 10 7 10-7" />
                </svg>
                mbyourk@gmail.com
              </a>
            </li>
            {
              hasResume && (
                <li>
                  <a href={resumeUrl} target="_blank" rel="noopener">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <path d="M14 2v6h6" />
                      <path d="M16 13H8" />
                      <path d="M16 17H8" />
                      <path d="M10 9H8" />
                    </svg>
                    Резюме PDF
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </header>

      <section class="about">
        <h2 class="section-label">Обо мне</h2>
        <div class="about-text">
          {about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="skills">
        <h2 class="section-label">Навыки</h2>
        <div class="skills-grid">
          {
            skills.map((group) => (
              <div class="skill-group">
                <h3>{group.title}</h3>
                <ul class="tags">
                  {group.items.map((item) => (
                    <li class="tag">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="education">
        <h2 class="section-label">Образование</h2>
        <div class="edu-card">
          <h3>{education.university}</h3>
          <p class="edu-meta">{education.course} · {education.direction}</p>
          <dl class="edu-details">
            <div>
              <dt>Профиль</dt>
              <dd>{education.profile}</dd>
            </div>
            <div>
              <dt>Языки</dt>
              <dd>{education.languages}</dd>
            </div>
            <div>
              <dt>Дополнительно</dt>
              <dd>{education.additional}</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="experience">
        <h2>Опыт</h2>

        <div class="exp-item">
          <h3>Беспилотная платформа на базе электроквадроцикла</h3>
          <p class="exp-meta">Командный проект · 2025 — наст. время</p>
          <ul>
            <li>Разработка 3D-моделей узлов и компонентов в Siemens NX, SolidWorks, Компас 3D</li>
            <li>Анализ конструкции с точки зрения прочности, устойчивости к нагрузкам и технологичности</li>
            <li>Конструктивные решения для размещения оборудования</li>
            <li>Сборка и тестирование прототипа</li>
            <li>Проектирование компоновки системы: новых элементов на готовой раме, системы дистанционного управления торможением с серво мотором, крепления</li>
          </ul>
        </div>

        <ul class="highlights">
          <li>Реальный инженерный проект</li>
          <li>Командная работа</li>
          <li>Механические системы и транспортные решения</li>
        </ul>
      </section>

      <section class="directions">
        <h2 class="section-label">Направления</h2>
        {
          visibleSections.length === 0 ? (
            <div class="empty">
              Пока нет проектов. Поставьте репозиторию топик из{' '}
              <code>src/data/sections.ts</code> — он появится здесь автоматически.
            </div>
          ) : (
            <div class="grid">
              {visibleSections.map(({ section, projects }) => (
                <SectionCard section={section} count={projects.length} />
              ))}
            </div>
          )
        }
      </section>

      <section class="projects">
        <h2 class="section-label">Последние проекты</h2>
        {
          recent.length === 0 ? (
            <div class="empty">
              Пока нет проектов. Создайте репо с одним из топиков из{' '}
              <code>src/data/sections.ts</code> — он подтянется сюда автоматически.
            </div>
          ) : (
            <div class="grid">
              {recent.map((p) => (
                <ProjectCard project={p} />
              ))}
            </div>
          )
        }
      </section>

      <footer class="bottom">
        {buildDate} · {plural(allProjects.length, 'проект', 'проекта', 'проектов')}
      </footer>
    </main>
  </body>
</html>
