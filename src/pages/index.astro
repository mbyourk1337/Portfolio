---
import '../styles/global.css';
import ProjectCard from '../components/ProjectCard.astro';
import { loadProjects } from '../lib/github';

const projects = await loadProjects();
const buildDate = new Date().toISOString().slice(0, 10);
const avatar = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/avatar.jpg`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Пустовойтов Константин — портфолио</title>
    <meta
      name="description"
      content="Портфолио Константина Пустовойтова, Московский политех."
    />
  </head>
  <body>
    <main class="container">
      <header class="hero">
        <img class="avatar" src={avatar} alt="Пустовойтов Константин" />
        <div class="hero-text">
          <h1>Пустовойтов Константин</h1>
          <ul class="facts">
            <li>20 лет</li>
            <li>Москва</li>
            <li>Московский политех</li>
          </ul>
          <ul class="contacts">
            <li>
              <a href="https://t.me/Mbyourd" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m22 2-7 20-4-9-9-4Z" />
                  <path d="M22 2 11 13" />
                </svg>
                @Mbyourd
              </a>
            </li>
            <li>
              <a href="mailto:mbyourk@gmail.com">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m2 6 10 7 10-7" />
                </svg>
                mbyourk@gmail.com
              </a>
            </li>
          </ul>
        </div>
      </header>

      <section class="experience">
        <h2>Опыт</h2>

        <div class="exp-item">
          <h3>Беспилотная платформа на базе электроквадроцикла</h3>
          <p class="exp-meta">Командный проект · 2025 — наст. время</p>
          <ul>
            <li>Разработка 3D-моделей узлов и компонентов в Siemens NX</li>
            <li>Проектирование компоновки системы: аккумулятор, электроника, крепления</li>
            <li>Конструктивные решения для размещения оборудования</li>
            <li>Сборка и тестирование прототипа</li>
            <li>Анализ конструкции с точки зрения прочности и технологичности</li>
          </ul>
        </div>

        <ul class="highlights">
          <li>Реальный инженерный проект</li>
          <li>Командная работа</li>
          <li>Механические системы и транспортные решения</li>
        </ul>
      </section>

      <section class="projects">
        <h2 class="section-label">Проекты</h2>
        {
          projects.length === 0 ? (
            <div class="empty">
              Пока нет проектов. Создайте репо с топиком{' '}
              <code>portfolio-project</code> — он подтянется сюда автоматически.
            </div>
          ) : (
            <div class="grid">
              {projects.map((p) => (
                <ProjectCard project={p} />
              ))}
            </div>
          )
        }
      </section>

      <footer class="bottom">
        {buildDate} · {projects.length} проект(ов)
      </footer>
    </main>
  </body>
</html>
